{
  "name": "portal-react-apps",
  "version": "3.1.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "config": {
    "yarnVersion": "4.18.1"
  },
  "workspaces": [
    "apps/*"
  ],
  "resolutions": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jquery": "3.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "ci": "yarn install --immutable",
    "ci:prod": "yarn install --immutable",
    "build:docker-clean": "docker image rm portal-react-apps:latest-builder-base",
    "build:docker-all": "docker buildx bake --set \\*.args.YARN_VERSION=4.18.1 --file docker-bake-build.hcl",
    "lint": "npx eslint --config eslint.config.mjs ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3"
  }
}
